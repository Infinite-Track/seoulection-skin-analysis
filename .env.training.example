# 학습·파이프라인·Prefect 쪽 환경변수 예시. 복사해서 쓴다: cp .env.training.example .env.training && set -a && . ./.env.training && set +a
# 서빙 컨테이너(.env.example)와는 별개다. 비밀값(액세스 키·토큰·계정 ID)은 여기에도, git에도 넣지 않는다 — AWS 자격 증명은
# boto3 기본 체인(SSO 프로필, 환경변수, EC2/Prefect 워커의 IAM 역할)으로 받는다.

# ---- AWS (pipelines/sagemaker_pipeline.py, pipelines/prefect_flow.py, scripts/upload_datasets.py)
# SageMaker 실행 역할 ARN. upsert·definition(dry-run이 아닐 때)에 필수. 코드·configs에는 적지 않는다
SAGEMAKER_ROLE_ARN=
# 자격 증명 프로필 (선택). 리전은 configs/paths.yaml aws_region 에서 읽어 AWS_DEFAULT_REGION 으로 넣는다
AWS_PROFILE=
# upsert 때 SDK가 iam:SimulatePrincipalPolicy 로 역할을 검사한다. 그 권한이 없으면 false 로 생략 (definition --dry-run 은 자동으로 false)
SAGEMAKER_VALIDATE_ROLE=

# ---- Prefect 주간 플로우 (pipelines/prefect_flow.py)
# 이 수보다 feedback/ 신규 파일이 적으면 파이프라인을 시작하지 않는다. 없으면 configs/prefect.yaml new_data.min_new_files (1)
MIN_NEW_FEEDBACK_FILES=50
# serve 가 붙을 Prefect 서버/Cloud. 비우면 로컬 임시 서버 (상시 운영에는 서버/Cloud 주소 + Cloud면 PREFECT_API_KEY)
PREFECT_API_URL=
PREFECT_API_KEY=

# ---- 데이터 준비 (scripts/prepare_aihub.py, scripts/build_crops.py)
# AI-Hub 원본의 "1.데이터" 폴더 (Training/, Validation/ 가 있는 곳). 원본은 S3에 올리지 않는다
AIHUB_RAW_ROOT=
# mediapipe 모델 폴더 (서빙과 같은 변수). 없으면 configs/paths.yaml mediapipe_models (models/mediapipe)
MEDIAPIPE_MODELS_DIR=

# ---- SageMaker 컨테이너 안에서만 (SageMaker가 자동으로 넣는다 — 로컬에서는 비워 둔다)
# SM_CHANNEL_TRAIN       Prepare 출력(학습 데이터셋) — configs/train_pipeline.yaml datasets[].name 과 같은 이름의 채널이 dir 을 대신한다
# SM_CHANNEL_BASE_MODEL  현재 운영 모델 폴더 (model.pt 또는 deploy_model.pt) = --init-from
# SM_MODEL_DIR           산출물 폴더 (= --model-dir)
