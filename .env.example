# 복사해서 .env로 쓴다: cp .env.example .env  (docker run --env-file .env). .env는 git에 올리지 않는다.
# docker --env-file 형식: 한 줄에 VAR=값. 값 뒤에 주석을 붙이면 값의 일부가 되니 주석은 줄 맨 앞에만.

# ---- Kafka (팀 운영, PLAINTEXT, 인증 없음). false면 API만 뜬다 (로컬 테스트)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-1.kafka.internal:9092,kafka-2.kafka.internal:9092,kafka-3.kafka.internal:9092
KAFKA_GROUP_ID=skin-analysis
KAFKA_TOPIC_REQUESTED=skin.analysis.requested.v1
KAFKA_TOPIC_COMPLETED=skin.analysis.completed.v1

# ---- HTTP API
API_HOST=0.0.0.0
API_PORT=8000

# ---- 모델
# false면 더미 결과(modelVersion=dummy)로 Kafka 흐름만 테스트. 운영에서는 반드시 true
MODEL_ENABLED=true
# skin.onnx, skin.onnx.data, meta.json이 있는 폴더. 컨테이너에는 볼륨으로 마운트 (로컬 실행이면 models/skin_v2)
MODEL_DIR=/models/skin_v2
# 설정하면 MODEL_DIR에 파일이 없을 때 여기서 받는다 (예: s3://bucket/models/skin_v2). 버킷 준비 전이라 비워 둠
MODEL_S3_URI=
# 이미지 안에 빌드 때 받아 둔 위치 (로컬 실행이면 models/mediapipe)
MEDIAPIPE_MODELS_DIR=/app/models/mediapipe

# ---- AWS: 액세스 키는 넣지 않는다 (EC2 IAM 역할). 리전만
AWS_REGION=us-east-1

# ---- 입력 품질 기준 (skin v2 학습 데이터와 같은 값)
MIN_PIXELS=1000000
MIN_SKIN_PX=20000

LOG_LEVEL=INFO
